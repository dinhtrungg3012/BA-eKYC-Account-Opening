        <mxCell id="backbone-label" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontColor=#16365C;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" value="&lt;b&gt;BACKBONE&lt;/b&gt;&lt;br&gt;Các hoạt động chính theo hành trình khách hàng" vertex="1">
