          <mxGeometry height="105" width="280" x="860" y="675" as="geometry" />
        </mxCell>
        <mxCell id="us17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US17 — Từ chối CCCD trùng&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn nhận lý do rõ ràng khi CCCD đã tồn tại và hồ sơ bị từ chối." vertex="1">
          <mxGeometry height="105" width="280" x="1165" y="675" as="geometry" />
        </mxCell>
        <mxCell id="us18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US18 — Theo dõi trạng thái&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn biết hồ sơ đang xử lý, chờ xét duyệt thủ công, từ chối hay hoàn tất." vertex="1">
          <mxGeometry height="105" width="280" x="1165" y="790" as="geometry" />
        </mxCell>
        <mxCell id="us19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US19 — Kiểm tra mật khẩu/PIN&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn được cảnh báo khi mật khẩu hoặc PIN không đúng định dạng để sửa ngay." vertex="1">
          <mxGeometry height="105" width="270" x="1470" y="675" as="geometry" />
