        <mxCell id="us12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US12 — OTP không hợp lệ&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn được thông báo khi OTP sai và nhập lại không giới hạn để tiếp tục xác thực." vertex="1">
          <mxGeometry height="105" width="280" x="250" y="675" as="geometry" />
        </mxCell>
        <mxCell id="us13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US13 — Chụp lại CCCD&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn chụp lại CCCD khi OCR thất bại và tổng số lần thất bại còn dưới 3." vertex="1">
          <mxGeometry height="85" width="280" x="555" y="675" as="geometry" />
