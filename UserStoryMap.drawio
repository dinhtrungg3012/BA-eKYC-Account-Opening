        <mxCell id="r1-label" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#70AD47;strokeColor=#548235;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;RELEASE 1 — MVP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Must-have&lt;br&gt;Luồng thành công cơ bản&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Có thể bàn giao bản đầu tiên&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="190" x="35" y="305" as="geometry" />
        </mxCell>
        <mxCell id="us01" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US01 — Nhập số điện thoại&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn nhập SĐT để nhận mã OTP xác thực." vertex="1">
          <mxGeometry height="85" width="280" x="250" y="325" as="geometry" />
        </mxCell>
        <mxCell id="us02" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US02 — Xác thực OTP&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn nhập OTP hợp lệ để tiếp tục mở tài khoản." vertex="1">
          <mxGeometry height="85" width="280" x="250" y="420" as="geometry" />
        </mxCell>
        <mxCell id="us03" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US03 — Chụp CCCD&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn chụp hai mặt CCCD gắn chip để hệ thống xác thực giấy tờ." vertex="1">
          <mxGeometry height="85" width="280" x="555" y="325" as="geometry" />
        </mxCell>
        <mxCell id="us04" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US04 — OCR thông tin CCCD&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn hệ thống tự trích xuất thông tin để không phải nhập thủ công." vertex="1">
          <mxGeometry height="85" width="280" x="555" y="420" as="geometry" />
        </mxCell>
        <mxCell id="us05" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US05 — Xác thực khuôn mặt&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn thực hiện Face Matching và Liveness để chứng minh đúng chủ giấy tờ." vertex="1">
          <mxGeometry height="100" width="280" x="555" y="515" as="geometry" />
        </mxCell>
        <mxCell id="us06" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US06 — Kiểm tra thông tin&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn kiểm tra thông tin OCR đã trích xuất trước khi gửi hồ sơ." vertex="1">
          <mxGeometry height="85" width="280" x="860" y="325" as="geometry" />
        </mxCell>
        <mxCell id="us07" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US07 — Xác nhận và gửi hồ sơ&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn xác nhận điều khoản và gửi hồ sơ để ngân hàng xử lý." vertex="1">
          <mxGeometry height="100" width="280" x="860" y="420" as="geometry" />
        </mxCell>
        <mxCell id="us08" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US08 — Kiểm tra CCCD trùng lặp&lt;/b&gt;&lt;br&gt;Là ngân hàng, tôi muốn kiểm tra CCCD với dữ liệu khách hàng chính thức trước khi tạo tài khoản." vertex="1">
          <mxGeometry height="100" width="280" x="1165" y="325" as="geometry" />
        </mxCell>
        <mxCell id="us09" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US09 — Nhận số tài khoản&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn nhận thông báo kèm số tài khoản sau khi CIF và tài khoản được tạo thành công." vertex="1">
          <mxGeometry height="100" width="280" x="1165" y="435" as="geometry" />
