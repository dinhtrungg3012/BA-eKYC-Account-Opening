        <mxCell id="persona" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#5B9BD5;fontColor=#1F1F1F;fontSize=14;align=left;spacingLeft=16;verticalAlign=middle;" value="&lt;b&gt;Persona chính:&lt;/b&gt; Khách hàng cá nhân Việt Nam, từ đủ 18 tuổi, có CCCD gắn chip. &amp;nbsp; | &amp;nbsp; &lt;b&gt;Mục tiêu:&lt;/b&gt; Hoàn tất mở tài khoản, nhận số tài khoản và thiết lập eBanking/PIN hoàn toàn online." vertex="1">
