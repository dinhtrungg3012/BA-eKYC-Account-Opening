        <mxCell id="us10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US10 — Thiết lập mật khẩu&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn thiết lập mật khẩu eBanking để đăng nhập dịch vụ." vertex="1">
          <mxGeometry height="85" width="270" x="1470" y="325" as="geometry" />
        </mxCell>
        <mxCell id="us11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US11 — Thiết lập mã PIN&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn thiết lập mã PIN để xác thực giao dịch." vertex="1">
