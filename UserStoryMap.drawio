        <mxCell id="r2-label" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFC000;strokeColor=#BF9000;fontColor=#1F1F1F;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;RELEASE 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Should-have&lt;br&gt;Xử lý lỗi, retry và các nhánh ngoại lệ&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Làm hành trình đầy đủ và an toàn hơn&lt;/font&gt;" vertex="1">
          <mxGeometry height="315" width="190" x="35" y="655" as="geometry" />
