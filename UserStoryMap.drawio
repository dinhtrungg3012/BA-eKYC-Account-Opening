        <mxCell id="us14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US14 — Thực hiện lại khuôn mặt&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn thử lại Face Matching/Liveness khi chưa đủ 3 lần thất bại." vertex="1">
          <mxGeometry height="85" width="280" x="555" y="770" as="geometry" />
        </mxCell>
        <mxCell id="us15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacing=9;" value="&lt;b&gt;US15 — Xét duyệt thủ công&lt;/b&gt;&lt;br&gt;Là khách hàng, tôi muốn hồ sơ được chuyển xét duyệt thủ công khi tổng thất bại eKYC đạt 3." vertex="1">
          <mxGeometry height="85" width="280" x="555" y="865" as="geometry" />
