        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#16365C;fontColor=#FFFFFF;fontSize=15;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;A1. XÁC THỰC SỐ ĐIỆN THOẠI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Bắt đầu hành trình và xác minh số điện thoại&lt;/font&gt;" vertex="1">
